---
// NextUI palette studio for the TrimUI Brick. Seven colors (color1..color7, RGBA)
// drive a live mock-up of the NextUI list screen; each is edited with an HSV wheel +
// value + alpha. Exports the NextUI Palettes .txt format and a share link. The device
// photo + screen mask (perspective-warped live screen) get wired once assets land.
---

<div class="nu">
  <div class="nu-stage">
    <div class="nu-stagebar">
      <div class="nu-modes" role="group" aria-label="Preview mode">
        <button type="button" id="nu-mode-photo" class="nu-mode on" aria-pressed="true">Photo</button>
        <button type="button" id="nu-mode-render" class="nu-mode" aria-pressed="false">Render</button>
      </div>
      <select id="nu-device" class="nu-device" aria-label="Device" hidden></select>
    </div>

    <div class="nu-render" id="nu-render" hidden>
      <div class="nu-render-inner" id="nu-render-inner">
        <img class="nu-render-img" id="nu-render-img" alt="" />
        <div class="nu-render-screen" id="nu-render-screen"></div>
      </div>
    </div>

    <div class="nu-photo" id="nu-photo">
      <div class="nu-photo-inner" id="nu-photo-inner">
        <img class="nu-photo-img" src="/nextui/brick.png" width="1496" height="1126" alt="TrimUI Brick running NextUI" />
        <div class="nu-screen-clip">
          <div class="nu-screen" id="nu-screen">
            <span class="nu-status">
              <svg class="nu-wifi" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3.5 10.5a12 12 0 0117 0" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/><path d="M7.3 14.3a6.7 6.7 0 019.4 0" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/><circle cx="12" cy="18.6" r="1.7" fill="currentColor"/></svg>
              <span class="nu-batt"><span class="nu-batt-pct">93</span></span>
              <span class="nu-clock">13:35</span>
            </span>
            <ul class="nu-list" id="nu-list"></ul>
            <div class="nu-hints">
              <span class="nu-hint"><b class="nu-pill">POWER</b> SLEEP</span>
              <span class="nu-hint"><b class="nu-glyph">A</b> OPEN</span>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="nu-picker">
      <canvas id="nu-wheel" width="200" height="200" class="nu-wheel" aria-label="Color wheel"></canvas>
      <div class="nu-sliders">
        <label class="nu-slabel">Brightness <span id="nu-vval"></span></label>
        <input type="range" id="nu-value" class="nu-range" min="0" max="100" value="100" />
        <label class="nu-slabel">Alpha <span id="nu-aval"></span></label>
        <input type="range" id="nu-alpha" class="nu-range nu-range-alpha" min="0" max="100" value="100" />
        <div class="nu-hexrow">
          <span class="nu-swatch-lg" id="nu-swatch-lg"></span>
          <input type="text" id="nu-hex" class="nu-hexin" spellcheck="false" maxlength="9" />
        </div>
      </div>
    </div>
  </div>

  <div class="nu-controls">
    <div class="nu-elements" id="nu-elements"></div>

    <div class="nu-actions">
      <select id="nu-scheme" class="nu-scheme" aria-label="Color harmony">
        <option value="auto">Auto harmony</option>
        <option value="analogous">Analogous</option>
        <option value="complementary">Complementary</option>
        <option value="split">Split complementary</option>
        <option value="triadic">Triadic</option>
        <option value="mono">Monochromatic</option>
      </select>
      <button type="button" id="nu-rand" class="primary">Randomize</button>
      <button type="button" id="nu-reset">Reset</button>
    </div>

    <input type="text" id="nu-name" class="nu-namein" placeholder="Theme name" maxlength="40" />
    <button type="button" id="nu-copy" class="nu-export">Copy theme code</button>
    <button type="button" id="nu-dl" class="nu-export">Download .txt</button>
    <pre id="nu-code" class="nu-code"></pre>
    <button type="button" id="nu-share" class="nu-share">Copy share link</button>
  </div>
</div>

<style is:global>
  /* NextUI's default UI font (Rounded Mplus 1c Bold), subset to Latin */
  @font-face {
    font-family: 'NextUI Rounded';
    src: url('/nextui/nextui.ttf') format('truetype');
    font-weight: 700; font-style: normal; font-display: swap;
  }
  .nu { display: flex; flex-wrap: wrap; gap: 1.4rem; align-items: flex-start; margin-top: 1.25rem; }
  .nu-stage { flex: 1 1 340px; min-width: 300px; }
  .nu-stagebar { display: flex; gap: .5rem; align-items: center; max-width: 640px; margin: 0 auto .5rem; }
  .nu-modes { display: inline-flex; border-radius: 8px; overflow: hidden; border: 1px solid var(--sl-color-gray-5); }
  .nu-mode { margin: 0; padding: 0 .7rem; height: 30px; border: 0; background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-2); font: inherit; font-size: .76rem; font-weight: 600; cursor: pointer; }
  .nu-mode.on { background: var(--sl-color-accent); color: var(--sl-color-black); }
  .nu-device { flex: 1 1 0; height: 30px; margin: 0; border-radius: 8px; font: inherit; font-size: .76rem;
    font-weight: 600; padding: 0 .4rem; background: var(--sl-color-gray-6); color: var(--sl-color-white);
    border: 1px solid var(--sl-color-gray-5); }

  /* Render mode: flat SVG device art, so the screen is a plain scale/translate onto
     the artwork's screen rect - none of the photo's perspective warp or PNG mask. */
  /* Deliberately a fixed neutral, not palette-derived: a stage that shifts with the
     colors throws off how those colors read on the screen next to it. This mid gray
     holds its own against both a black and a white colorway. */
  /* Fixed box, sized for the tallest artwork (the square Brick canvas, plus a hair
     of margin). The wide Smart Pro art just centers inside it, so switching colorway
     no longer resizes the stage and shoves the page around. */
  .nu-render { width: 100%; max-width: 640px; margin: 0 auto; position: relative;
    aspect-ratio: 100 / 102; display: flex; align-items: center;
    border-radius: 12px; box-sizing: border-box; background: #73777d; overflow: hidden; }
  .nu-render-inner { position: relative; width: 100%; }
  /* The site frames content images with a border + glow; the device art is a
     cut-out, so strip that or it reads as a photo in a box. */
  .nu-render-inner img.nu-render-img { display: block; width: 100%; height: auto; margin: 0;
    border: 0; border-radius: 0; box-shadow: none !important; background: none; }
  .nu-render-screen { position: absolute; overflow: hidden; margin: 0; }
  .nu-render[hidden], .nu-photo[hidden], .nu-device[hidden] { display: none; }
  /* device photo with the live screen perspective-warped onto the masked quad */
  .nu-photo { width: 100%; max-width: 640px; margin: 0 auto; position: relative; aspect-ratio: 1496 / 1126; }
  /* Composite authored at HALF the photo's native pixels (748x563, not 1496x1126): every
     transformed/masked/filtered layer gets its own GPU buffer sized to CSS px x DPR x pinch-zoom,
     and iOS Safari OOM-crashes ("A problem repeatedly occurred") when those buffers balloon on
     pinch. Half the coordinate space = quarter the buffer per layer, with no visible change
     (the photo still displays <=640px). The screen-mask source stays high-res, downsampled here. */
  .nu-photo-inner { position: absolute; top: 0; left: 0; width: 748px; height: 563px; transform-origin: top left; }
  .nu-photo-img { display: block; width: 748px; height: 563px; margin: 0; }
  .nu-screen-clip { position: absolute; inset: 0; margin: 0;
    -webkit-mask: url(/nextui/screen-mask.png) 0 0 / 748px 563px no-repeat;
    mask: url(/nextui/screen-mask.png) 0 0 / 748px 563px no-repeat; }
  .nu-divider { font-size: .66rem; text-transform: uppercase; letter-spacing: .06em; font-weight: 700;
    color: var(--sl-color-gray-3); margin: .5rem 0 .05rem; }
  .nu-screen {
    position: absolute; top: 0; left: 0; width: 800px; height: 600px; transform-origin: 0 0;
    background: var(--c7); color: var(--c4); overflow: hidden;
    font: 800 34px/1.2 'NextUI Rounded', system-ui, -apple-system, sans-serif;
    display: flex; flex-direction: column;
  }
  /* status cluster: accent (color2) pill (wifi + battery + clock in color6), floats top-right */
  .nu-status { position: absolute; top: 14px; right: 16px; z-index: 2;
    display: inline-flex; align-items: center; gap: 11px;
    background: var(--c2); color: var(--c6); border-radius: 999px; height: 64px; padding: 0 21px; font-size: 29px; }
  .nu-wifi { width: 36px; height: 36px; display: block; color: var(--c6); }
  .nu-batt { position: relative; box-sizing: border-box; width: 56px; height: 30px;
    border: 2.5px solid var(--c6); border-radius: 6px; display: inline-flex; align-items: center; justify-content: center; }
  .nu-batt::after { content: ''; position: absolute; left: -5px; top: 50%; transform: translateY(-50%);
    width: 4px; height: 14px; background: var(--c6); border-radius: 2px 0 0 2px; }
  .nu-batt-pct { font-size: 20px; line-height: 1; color: var(--c6); }
  .nu-clock { color: var(--c6); }
  .nu-list { list-style: none; margin: 0; padding: .45em .55em .1em; flex: 1 1 auto; min-height: 0; overflow: hidden;
    display: flex; flex-direction: column; gap: .08em; font-size: 1.08em; letter-spacing: -.015em; }
  .nu-row { padding: .44em .8em; border-radius: 999px; color: var(--c4);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; -webkit-text-stroke: .3px currentColor; }
  /* selected row: color1 (Main) pill via GFX_blitPillDark, text in color5 */
  .nu-row.sel { background: var(--c1); color: var(--c5); }
  .nu-hints { display: flex; justify-content: space-between; gap: 1em; padding: 16px 20px; color: var(--c6); font-size: 30px; align-items: center; }
  /* each hint group sits in its own accent (color2) backing pill - same height as a list pill */
  .nu-hint { display: inline-flex; align-items: center; gap: 10px; background: var(--c2); border-radius: 999px; height: 64px; padding: 0 20px; }
  /* multi-char button (e.g. POWER) - a color1 pill nested concentrically in the group pill */
  .nu-pill { display: inline-flex; align-items: center; justify-content: center; height: 44px; padding: 0 16px;
    border-radius: 999px; background: var(--c1); color: var(--c3); font-size: 28px; font-weight: 800; }
  /* button glyph: color1 circle with the letter in color3 (ALT_BUTTON_TEXT_COLOR = accent2) */
  .nu-glyph { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px;
    border-radius: 50%; background: var(--c1); color: var(--c3); font-size: 30px; font-weight: 800; }
  .nu-note { text-align: center; margin: .7rem 0 0; font-size: .78rem; color: var(--sl-color-gray-3); }

  .nu-controls { flex: 0 0 300px; display: flex; flex-direction: column; gap: .7rem; }
  .nu-elements { display: flex; flex-direction: column; gap: .3rem; }
  .nu-el { display: flex; align-items: center; gap: .6rem; padding: .35rem .5rem; border-radius: 8px; cursor: pointer;
    border: 1px solid transparent; background: var(--sl-color-gray-6); }
  .nu-el.active { border-color: var(--sl-color-accent); }
  .nu-el-sw { width: 22px; height: 22px; border-radius: 5px; flex: 0 0 auto;
    box-shadow: inset 0 0 0 1px rgba(128,128,128,.4);
    background-image: linear-gradient(45deg,#888 25%,transparent 25%,transparent 75%,#888 75%),linear-gradient(45deg,#888 25%,#bbb 25%,#bbb 75%,#888 75%);
    background-size: 10px 10px; background-position: 0 0, 5px 5px; }
  .nu-el-sw span { display: block; width: 100%; height: 100%; border-radius: 5px; }
  .nu-el-name { flex: 1 1 auto; font-size: .82rem; font-weight: 600; color: var(--sl-color-white); }
  .nu-el-hex { font-size: .72rem; font-family: ui-monospace, monospace; color: var(--sl-color-gray-3); }
  /* Lock: keeps a swatch out of Randomize. Dim until engaged so a row of unlocked
     padlocks doesn't read as noise. */
  .nu-lock { flex: 0 0 auto; width: 26px; height: 26px; margin: 0; padding: 0; border: 0; border-radius: 6px;
    background: transparent; cursor: pointer; line-height: 1; font-size: .82rem; opacity: .35;
    color: var(--sl-color-gray-2); }
  .nu-lock:hover { opacity: .75; background: var(--sl-color-gray-5); }
  .nu-el.locked .nu-lock { opacity: 1; color: var(--sl-color-accent); }
  .nu-el.locked { border-color: var(--sl-color-gray-4); }

  .nu-scheme { flex: 1 1 0; height: 38px; margin: 0; border-radius: 8px; font: inherit; font-weight: 600;
    font-size: .8rem; padding: 0 .5rem; background: var(--sl-color-gray-6);
    color: var(--sl-color-white); border: 1px solid var(--sl-color-gray-5); }


  .nu-picker { display: flex; gap: 1rem; align-items: flex-start; margin: 1rem auto 0; max-width: 640px; }
  .nu-wheel { width: 168px; height: 168px; touch-action: none; cursor: crosshair; flex: 0 0 auto; }
  .nu-sliders { flex: 1 1 auto; display: flex; flex-direction: column; gap: .25rem; }
  .nu-slabel { font-size: .72rem; font-weight: 700; color: var(--sl-color-gray-2); display: flex; justify-content: space-between; }
  .nu-range { width: 100%; margin: 0 0 .3rem; accent-color: var(--sl-color-accent); }
  .nu-hexrow { display: flex; align-items: center; gap: .5rem; margin-top: .2rem; }
  .nu-swatch-lg { width: 30px; height: 30px; border-radius: 6px; flex: 0 0 auto; box-shadow: inset 0 0 0 1px rgba(128,128,128,.4);
    background-image: linear-gradient(45deg,#888 25%,transparent 25%,transparent 75%,#888 75%),linear-gradient(45deg,#888 25%,#bbb 25%,#bbb 75%,#888 75%);
    background-size: 12px 12px; background-position: 0 0, 6px 6px; }
  .nu-swatch-lg span { display: block; width: 100%; height: 100%; border-radius: 6px; }
  .nu-hexin, .nu-namein { flex: 1 1 auto; height: 32px; box-sizing: border-box; padding: 0 .5rem; border-radius: 8px;
    border: 1px solid var(--sl-color-gray-5); background: var(--sl-color-bg); color: var(--sl-color-white);
    font: inherit; font-size: .85rem; font-family: ui-monospace, monospace; }
  .nu-namein { font-family: inherit; }

  .nu-actions { display: flex; gap: .6rem; }
  .nu-actions button { flex: 1 1 0; height: 38px; margin: 0; border-radius: 8px; cursor: pointer; font: inherit; font-weight: 600;
    border: 1px solid var(--sl-color-gray-5); background: var(--sl-color-gray-6); color: var(--sl-color-white); }
  .nu-actions button.primary { background: var(--sl-color-accent); border-color: var(--sl-color-accent); color: var(--sl-color-black); }
  .nu-export, .nu-share { width: 100%; height: 36px; margin: 0; box-sizing: border-box; border-radius: 8px; cursor: pointer; font: inherit; font-weight: 600; font-size: .85rem;
    border: 1px solid var(--sl-color-gray-5); background: var(--sl-color-gray-6); color: var(--sl-color-white); }
  .nu-share { border-style: dashed; background: transparent; color: var(--sl-color-gray-2); }
  .nu-code { margin: 0; padding: .6rem .7rem; border-radius: 8px; background: var(--sl-color-gray-6);
    font-size: .72rem; line-height: 1.5; white-space: pre; overflow-x: auto; color: var(--sl-color-gray-2); }
</style>

<script>
  // 7 palette slots - NextUI color1..color7 with their default packed RGBA.
  const ELS = [
    { key: 'c1', name: 'Main',                def: 0xffffffff },
    { key: 'c2', name: 'Primary Accent',      def: 0x9b2257ff },
    { key: 'c3', name: 'Secondary Accent',    def: 0x1e2329ff },
    { key: 'c4', name: 'List Text',           def: 0xffffffff },
    { key: 'c5', name: 'List Text Selected',  def: 0x000000ff },
    { key: 'c6', name: 'Hint / Info',         def: 0xffffffff },
    { key: 'c7', name: 'Background',          def: 0x000000ff },
  ];
  const LIST_ROWS = ['Recently Played', 'Super Nintendo', 'Nintendo 64', 'PlayStation',
                     'Sega Genesis', 'Tools'];
  const SEL_ROW = 3;

  const state = {};   // key -> {r,g,b,a}  (a 0-255)
  const locked = {};  // key -> true when Randomize must leave the swatch alone
  let active = 'c2';
  let name = 'Custom';
  // Authoritative hue/sat for the active swatch. Re-deriving these from the packed
  // RGB on every edit round-trips through 8-bit quantization, so dragging Brightness
  // made the wheel marker drift - and at 0 the color is pure black, where hue/sat no
  // longer exist at all (the marker snapped to the center and the hue was lost for
  // good). Keeping them here means Brightness only ever changes V.
  let curH = 0, curS = 0;

  // ---- color math ----
  const unpack = (v) => ({ r: (v>>>24)&255, g: (v>>>16)&255, b: (v>>>8)&255, a: v&255 });
  const clamp = (n,a,b) => Math.max(a, Math.min(b, n));
  const hex2 = (n) => n.toString(16).padStart(2,'0');
  const packHex = (c) => (hex2(c.r)+hex2(c.g)+hex2(c.b)+hex2(c.a)).toUpperCase();
  const cssRgba = (c) => `rgba(${c.r},${c.g},${c.b},${(c.a/255).toFixed(3)})`;
  function rgb2hsv(c) {
    const r=c.r/255, g=c.g/255, b=c.b/255, mx=Math.max(r,g,b), mn=Math.min(r,g,b), d=mx-mn;
    let h=0; if (d) { if (mx===r) h=((g-b)/d)%6; else if (mx===g) h=(b-r)/d+2; else h=(r-g)/d+4; h*=60; if (h<0) h+=360; }
    return { h, s: mx? d/mx : 0, v: mx };
  }
  function hsv2rgb(h,s,v) {
    const c=v*s, x=c*(1-Math.abs((h/60)%2-1)), m=v-c; let r=0,g=0,b=0;
    if (h<60){r=c;g=x;} else if (h<120){r=x;g=c;} else if (h<180){g=c;b=x;}
    else if (h<240){g=x;b=c;} else if (h<300){r=x;b=c;} else {r=c;b=x;}
    return { r: Math.round((r+m)*255), g: Math.round((g+m)*255), b: Math.round((b+m)*255) };
  }

  // ---- DOM refs ----
  const screen = document.getElementById('nu-screen');
  const listEl = document.getElementById('nu-list');
  const elsEl = document.getElementById('nu-elements');
  const wheel = document.getElementById('nu-wheel');
  const wctx = wheel.getContext('2d');
  const valueR = document.getElementById('nu-value');
  const alphaR = document.getElementById('nu-alpha');
  const hexIn = document.getElementById('nu-hex');
  const nameIn = document.getElementById('nu-name');
  const codeEl = document.getElementById('nu-code');

  // ---- render the live screen ----
  function paintScreen() {
    for (const e of ELS) screen.style.setProperty('--' + e.key, cssRgba(state[e.key]));
  }
  function buildList() {
    listEl.innerHTML = '';
    LIST_ROWS.forEach((t,i) => {
      const li = document.createElement('li');
      li.className = 'nu-row' + (i === SEL_ROW ? ' sel' : '');
      li.textContent = t;
      listEl.appendChild(li);
    });
  }

  // ---- element list ----
  function buildElements() {
    elsEl.innerHTML = '';
    ELS.forEach((e) => {
      const row = document.createElement('div');
      row.className = 'nu-el' + (e.key === active ? ' active' : '') + (locked[e.key] ? ' locked' : '');
      row.dataset.key = e.key;
      row.innerHTML = `<span class="nu-el-sw"><span data-sw="${e.key}"></span></span>`
        + `<span class="nu-el-name">${e.name}</span><span class="nu-el-hex" data-hx="${e.key}"></span>`
        + `<button type="button" class="nu-lock" data-lock="${e.key}" aria-pressed="${!!locked[e.key]}"`
        + ` title="Lock this color so Randomize leaves it alone">${locked[e.key] ? '🔒' : '🔓'}</button>`;
      row.addEventListener('click', () => { active = e.key; syncElements(); loadPicker(); });
      row.querySelector('.nu-lock').addEventListener('click', (ev) => {
        ev.stopPropagation();          // toggling a lock shouldn't also select the row
        locked[e.key] = !locked[e.key];
        syncElements();
      });
      elsEl.appendChild(row);
    });
    refreshSwatches();
  }
  function syncElements() {
    elsEl.querySelectorAll('.nu-el').forEach(r => {
      r.classList.toggle('active', r.dataset.key === active);
      r.classList.toggle('locked', !!locked[r.dataset.key]);
      const b = r.querySelector('.nu-lock');
      if (b) { b.textContent = locked[r.dataset.key] ? '🔒' : '🔓'; b.setAttribute('aria-pressed', !!locked[r.dataset.key]); }
    });
  }
  function refreshSwatches() {
    ELS.forEach(e => {
      const sw = elsEl.querySelector(`[data-sw="${e.key}"]`);
      const hx = elsEl.querySelector(`[data-hx="${e.key}"]`);
      if (sw) sw.style.background = cssRgba(state[e.key]);
      if (hx) hx.textContent = '#' + packHex(state[e.key]);
    });
  }

  // ---- color wheel (hue=angle, sat=radius) at the active value ----
  const WR = 100;      // wheel canvas radius (canvas is 200x200)
  let wheelV = 1;      // value the cached wheel was drawn at
  function drawWheel(v) {
    wheelV = v;
    const img = wctx.createImageData(200, 200), d = img.data;
    for (let y=0; y<200; y++) for (let x=0; x<200; x++) {
      const dx=x-WR, dy=y-WR, r=Math.sqrt(dx*dx+dy*dy), i=(y*200+x)*4;
      if (r > WR) { d[i+3]=0; continue; }
      let h = Math.atan2(dy,dx)*180/Math.PI; if (h<0) h+=360;
      const c = hsv2rgb(h, Math.min(r/WR,1), v);
      d[i]=c.r; d[i+1]=c.g; d[i+2]=c.b; d[i+3]=255;
    }
    wctx.putImageData(img, 0, 0);
    drawWheelMarker();
  }
  function drawWheelMarker() {
    const ang = curH*Math.PI/180, rr = curS*WR;
    const x = WR + Math.cos(ang)*rr, y = WR + Math.sin(ang)*rr;
    wctx.save();
    wctx.beginPath(); wctx.arc(x, y, 7, 0, Math.PI*2);
    wctx.lineWidth = 2; wctx.strokeStyle = '#000'; wctx.stroke();
    wctx.beginPath(); wctx.arc(x, y, 6, 0, Math.PI*2);
    wctx.lineWidth = 2; wctx.strokeStyle = '#fff'; wctx.stroke();
    wctx.restore();
  }

  function loadPicker() {
    const c = state[active], hsv = rgb2hsv(c);
    // The one place hue/sat are (re)derived: switching swatch, or a color set from
    // outside the wheel (hex entry, randomize, reset, shared link).
    curH = hsv.h; curS = hsv.s;
    valueR.value = Math.round(hsv.v*100);
    alphaR.value = Math.round(c.a/255*100);
    hexIn.value = '#' + packHex(c);
    document.getElementById('nu-vval').textContent = valueR.value + '%';
    document.getElementById('nu-aval').textContent = alphaR.value + '%';
    document.getElementById('nu-swatch-lg').style.background = cssRgba(c);
    drawWheel(hsv.v);
    styleAlpha();
  }
  function styleAlpha() {
    const c = state[active];
    alphaR.style.background = `linear-gradient(90deg, rgba(${c.r},${c.g},${c.b},0), rgb(${c.r},${c.g},${c.b}))`;
  }

  // Apply an HSVA change to the active element and refresh everything.
  function setActive(h, s, v, a) {
    const rgb = hsv2rgb(h, s, v);
    state[active] = { ...rgb, a };
    paintScreen(); refreshSwatches();
    document.getElementById('nu-swatch-lg').style.background = cssRgba(state[active]);
    hexIn.value = '#' + packHex(state[active]);
    styleAlpha(); updateCode(); updateURL();
  }

  // ---- wheel interaction ----
  function wheelPick(e) {
    const rect = wheel.getBoundingClientRect();
    const x = (e.clientX-rect.left)/rect.width*200 - WR, y = (e.clientY-rect.top)/rect.height*200 - WR;
    let h = Math.atan2(y,x)*180/Math.PI; if (h<0) h+=360;
    curH = h; curS = clamp(Math.sqrt(x*x+y*y)/WR, 0, 1);
    setActive(curH, curS, +valueR.value/100, +alphaR.value/100*255|0);
    drawWheel(wheelV); // redraw marker (value unchanged)
  }
  let wheelDrag = false;
  wheel.addEventListener('pointerdown', (e) => { wheelDrag = true; wheel.setPointerCapture(e.pointerId); wheelPick(e); });
  wheel.addEventListener('pointermove', (e) => { if (wheelDrag) wheelPick(e); });
  wheel.addEventListener('pointerup', () => { wheelDrag = false; });

  valueR.addEventListener('input', () => {
    document.getElementById('nu-vval').textContent = valueR.value + '%';
    setActive(curH, curS, +valueR.value/100, state[active].a);
    drawWheel(+valueR.value/100);
  });
  alphaR.addEventListener('input', () => {
    document.getElementById('nu-aval').textContent = alphaR.value + '%';
    state[active] = { ...state[active], a: Math.round(+alphaR.value/100*255) };
    paintScreen(); refreshSwatches(); styleAlpha();
    document.getElementById('nu-swatch-lg').style.background = cssRgba(state[active]);
    hexIn.value = '#' + packHex(state[active]); updateCode(); updateURL();
  });
  hexIn.addEventListener('change', () => {
    const m = /^#?([0-9a-fA-F]{6}([0-9a-fA-F]{2})?)$/.exec(hexIn.value.trim());
    if (!m) { hexIn.value = '#' + packHex(state[active]); return; }
    let h = m[1]; if (h.length === 6) h += 'ff';
    state[active] = { r: parseInt(h.slice(0,2),16), g: parseInt(h.slice(2,4),16), b: parseInt(h.slice(4,6),16), a: parseInt(h.slice(6,8),16) };
    paintScreen(); refreshSwatches(); loadPicker(); updateCode(); updateURL();
  });

  // ---- export / share ----
  function themeText() {
    const lines = ['version=1', 'name=' + (name || 'Custom')];
    ELS.forEach((e,i) => lines.push(`color${i+1}=0x${packHex(state[e.key])}`));
    return lines.join('\n') + '\n';
  }
  function updateCode() { codeEl.textContent = themeText(); }

  // Share code: base64url over the raw bytes rather than 56 hex characters. Alpha is
  // 255 on every color in almost every theme, so it is left out entirely unless some
  // color needs it, in which case a leading bitmask says which ones carry one at the
  // end. 21 bytes -> 28 characters for the usual case, half the old length.
  const b64u = {
    enc(bytes) {
      let s = ''; for (const b of bytes) s += String.fromCharCode(b);
      return btoa(s).replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,'');
    },
    dec(t) {
      const s = atob(t.replace(/-/g,'+').replace(/_/g,'/'));
      const b = new Uint8Array(s.length);
      for (let i = 0; i < s.length; i++) b[i] = s.charCodeAt(i);
      return b;
    },
  };
  function shareCode() {
    const cs = ELS.map(e => state[e.key]);
    let mask = 0;
    cs.forEach((c,i) => { if (c.a !== 255) mask |= 1 << i; });
    const bytes = [];
    if (mask) bytes.push(mask);
    cs.forEach(c => bytes.push(c.r, c.g, c.b));
    if (mask) cs.forEach(c => { if (c.a !== 255) bytes.push(c.a); });
    return b64u.enc(bytes);
  }
  // Decode a share code in either form. Returns null if it isn't one.
  function readShareCode(t) {
    // Legacy: 7 colors (or 9, from when the studio still had the two cosmetic LED
    // slots) as RGBA hex. The trailing LED bytes are read and dropped.
    if (/^([0-9a-fA-F]{8})+$/.test(t) && t.length >= ELS.length*8) {
      return ELS.map((e,i) => {
        const h = t.slice(i*8, i*8+8);
        return { r: parseInt(h.slice(0,2),16), g: parseInt(h.slice(2,4),16),
                 b: parseInt(h.slice(4,6),16), a: parseInt(h.slice(6,8),16) };
      });
    }
    if (!/^[A-Za-z0-9_-]+$/.test(t)) return null;
    let b; try { b = b64u.dec(t); } catch (_) { return null; }
    const n = ELS.length, rgb = n*3;
    if (b.length === rgb) {
      return ELS.map((e,i) => ({ r: b[i*3], g: b[i*3+1], b: b[i*3+2], a: 255 }));
    }
    if (b.length < rgb + 1) return null;
    const mask = b[0];
    let ai = rgb + 1;                       // alphas follow the RGB run, in order
    const out = ELS.map((e,i) => ({ r: b[1+i*3], g: b[2+i*3], b: b[3+i*3],
                                    a: (mask >> i) & 1 ? b[ai++] : 255 }));
    return ai === b.length ? out : null;    // trailing or missing alpha bytes: reject
  }
  function shareQuery() {
    return 't=' + shareCode() + (name && name !== 'Custom' ? '&n=' + encodeURIComponent(name) : '');
  }
  function updateURL() {
    history.replaceState(null, '', location.pathname + '?' + shareQuery());
  }
  // Kick off the Open Graph render the moment a link is copied, so the image is
  // cached by the time it's pasted. A config's first render is a ~12s browser
  // cold-start; warming it here front-loads that into the copy->paste gap.
  // Fire-and-forget; no-ops in dev/preview where the worker route doesn't exist.
  function warmOg() {
    try { fetch('/nextui-og?' + shareQuery(), { mode: 'no-cors', cache: 'no-store' }); } catch (_) {}
  }
  function applyURL() {
    const p = new URLSearchParams(location.search);
    const t = p.get('t');
    const cs = t ? readShareCode(t) : null;
    if (cs) ELS.forEach((e,i) => { state[e.key] = cs[i]; });
    else ELS.forEach(e => { state[e.key] = unpack(e.def); });
    const n = p.get('n'); if (n) name = n.slice(0,40);
  }

  async function copyText(t, btn, label) {
    try { await navigator.clipboard.writeText(t); }
    catch (_) { const ta = document.createElement('textarea'); ta.value = t; document.body.appendChild(ta); ta.select(); try { document.execCommand('copy'); } catch (_) {} ta.remove(); }
    const old = btn.textContent; btn.textContent = label;
    clearTimeout(btn._t); btn._t = setTimeout(() => { btn.textContent = old; }, 1500);
  }
  document.getElementById('nu-copy').addEventListener('click', (e) => copyText(themeText(), e.target, 'Copied!'));
  document.getElementById('nu-share').addEventListener('click', (e) => { updateURL(); warmOg(); copyText(location.href, e.target, 'Link copied!'); });
  document.getElementById('nu-dl').addEventListener('click', () => {
    const blob = new Blob([themeText()], { type: 'text/plain' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = (name || 'Custom').replace(/[^\w.-]+/g, '_') + '.txt';
    document.body.appendChild(a); a.click(); a.remove();
    setTimeout(() => URL.revokeObjectURL(a.href), 2000);
  });
  nameIn.addEventListener('input', () => { name = nameIn.value.trim() || 'Custom'; updateCode(); updateURL(); });

  document.getElementById('nu-reset').addEventListener('click', () => {
    ELS.forEach(e => { state[e.key] = unpack(e.def); });
    name = 'Custom'; nameIn.value = '';
    paintScreen(); refreshSwatches(); loadPicker(); updateCode(); updateURL();
  });
  // ---- contrast (WCAG) ----
  // Not surfaced anywhere: the ratios only exist so Randomize can keep the pairs the
  // rendered UI actually stacks legible (see FIXES below).
  const srgbLin = (n) => { const c = n/255; return c <= 0.03928 ? c/12.92 : Math.pow((c+0.055)/1.055, 2.4); };
  const relLum = (c) => 0.2126*srgbLin(c.r) + 0.7152*srgbLin(c.g) + 0.0722*srgbLin(c.b);
  function contrast(a, b) {
    const l1 = relLum(a), l2 = relLum(b);
    return (Math.max(l1,l2) + 0.05) / (Math.min(l1,l2) + 0.05);
  }

  // ---- harmony-aware randomize ----
  const SCHEMES = {
    analogous:     h => [h, (h+30)%360, (h+330)%360],
    complementary: h => [h, (h+180)%360],
    split:         h => [h, (h+150)%360, (h+210)%360],
    triadic:       h => [h, (h+120)%360, (h+240)%360],
    mono:          h => [h],
  };
  const SCHEME_KEYS = Object.keys(SCHEMES);
  const rnd = (a,b) => a + Math.random()*(b-a);
  const put = (key, h, s, v) => { if (!locked[key]) state[key] = { ...hsv2rgb(h,s,v), a: 255 }; };

  // Constraints grouped BY COLOR, not by pair. c6 is the awkward one: it's the status
  // text on the background AND the hint text on the accent pill, so it has to clear
  // both at once. Fixing pair-by-pair let the second fix quietly undo the first.
  const FIXES = [
    { fg:'c4', against:[['c7',4.5]] },
    { fg:'c5', against:[['c1',4.5]] },
    { fg:'c3', against:[['c1',3.0]] },
    { fg:'c6', against:[['c7',4.5], ['c2',4.5]] },
  ];
  // Move a foreground as little as possible until it clears every background it sits
  // on. Brightness first (keeps the hue), then desaturating, which opens up range a
  // saturated hue simply cannot reach. Never touches a locked swatch.
  function fixContrast(fgKey, against) {
    if (locked[fgKey]) return;
    // How much headroom the worst constraint has; >= 0 means everything passes.
    const score = (c) => Math.min(...against.map(([bg,min]) => contrast(c, state[bg]) - min));
    if (score(state[fgKey]) >= 0) return;
    const cur = rgb2hsv(state[fgKey]);
    let best = null, bestScore = -Infinity;
    const consider = (cand) => {
      const sc = score(cand);
      if (sc > bestScore) { bestScore = sc; best = cand; }
      return sc >= 0;
    };
    for (let d = 0; d <= 1.0001; d += 0.02) {
      for (const v of [cur.v + d, cur.v - d]) {
        if (v < 0 || v > 1) continue;
        const cand = { ...hsv2rgb(cur.h, cur.s, v), a: 255 };
        if (consider(cand)) { state[fgKey] = cand; return; }
      }
    }
    for (let s = cur.s - 0.1; s >= -0.0001; s -= 0.1) {
      for (let v = 0; v <= 1.0001; v += 0.02) {
        const cand = { ...hsv2rgb(cur.h, Math.max(s,0), v), a: 255 };
        if (consider(cand)) { state[fgKey] = cand; return; }
      }
    }
    if (best) state[fgKey] = best;   // unsatisfiable: keep the least-bad, readout warns
  }

  // The accent carries hint text whose polarity is dictated by the background, so the
  // accent needs to leave room for it. Constraining its HSV *value* isn't enough - a
  // yellow at v=.6 is far brighter than a blue at v=.6 - so pull its actual relative
  // luminance into the feasible band instead.
  function fitAccentLuminance(dark) {
    if (locked.c2) return;
    const want = (c) => dark ? relLum(c) <= 0.16 : relLum(c) >= 0.45;
    if (want(state.c2)) return;
    const cur = rgb2hsv(state.c2);
    const step = dark ? -0.02 : 0.02;
    for (let v = cur.v; v >= -0.0001 && v <= 1.0001; v += step) {
      const cand = { ...hsv2rgb(cur.h, cur.s, Math.min(Math.max(v,0),1)), a: 255 };
      if (want(cand)) { state.c2 = cand; return; }
    }
    // Very bright hues (yellows) can't get dark enough while fully saturated.
    for (let s = cur.s; s >= -0.0001; s -= 0.08) {
      for (let v = 0; v <= 1.0001; v += 0.02) {
        const cand = { ...hsv2rgb(cur.h, Math.max(s,0), v), a: 255 };
        if (want(cand)) { state.c2 = cand; return; }
      }
    }
  }

  function randomize() {
    const pick = document.getElementById('nu-scheme').value;
    const scheme = pick === 'auto'
      ? SCHEME_KEYS[Math.floor(Math.random()*SCHEME_KEYS.length)] : pick;
    // Seed from a locked color when there is one, so a lock steers the whole palette
    // instead of merely surviving it.
    const seedKey = ['c2','c1','c3','c6','c4','c7'].find(k => locked[k]);
    const baseH = seedKey ? rgb2hsv(state[seedKey]).h : Math.random()*360;
    const hues = SCHEMES[scheme](baseH);
    const hue = (i) => hues[i % hues.length];
    // Dark themes are the norm; honor a locked background's polarity if there is one.
    const dark = locked.c7 ? relLum(state.c7) < 0.25 : Math.random() < 0.75;

    put('c7', hue(0), rnd(0.10, 0.35), dark ? rnd(0.05, 0.14) : rnd(0.90, 0.99));  // background
    // The accent carries hint text, and that text follows the background's polarity
    // so on a dark theme the accent has to stay deep enough for light text, and on a
    // light theme light enough for dark text. Otherwise the pair is unsatisfiable.
    put('c2', hue(1), rnd(0.55, 0.90), dark ? rnd(0.32, 0.60) : rnd(0.62, 0.88));  // accent pill
    put('c1', hue(0), rnd(0.03, 0.16), dark ? rnd(0.88, 1.00) : rnd(0.10, 0.26));  // selection / button
    put('c3', hue(2), rnd(0.45, 0.85), dark ? rnd(0.12, 0.30) : rnd(0.70, 0.95));  // glyph on c1
    put('c4', hue(0), rnd(0.02, 0.12), dark ? rnd(0.92, 1.00) : rnd(0.04, 0.14));  // list text
    put('c5', hue(0), rnd(0.02, 0.12), dark ? rnd(0.04, 0.14) : rnd(0.92, 1.00));  // selected text
    put('c6', hue(1), rnd(0.05, 0.20), dark ? rnd(0.72, 0.92) : rnd(0.16, 0.34));  // hint / status

    fitAccentLuminance(dark);
    FIXES.forEach(f => fixContrast(f.fg, f.against));
  }

  document.getElementById('nu-rand').addEventListener('click', () => {
    randomize();
    paintScreen(); refreshSwatches(); loadPicker(); updateCode(); updateURL();
  });

  // ---- device photo: perspective-warp the 800x600 screen onto the masked quad ----
  const SCREEN_W = 800, SCREEN_H = 600;
  // Native photo space (half the 1496x1126 source - see the .nu-photo-inner note).
  const NW = 748;
  // Screen-quad corners (TL,TR,BR,BL) read from screen-mask.png, halved into the 748x563 space.
  const QUAD = [{x:291,y:144},{x:497.5,y:135.5},{x:490.5,y:288},{x:294.5,y:305.5}];
  function solve8(A, b) {
    const n = 8, M = A.map((r,i) => r.concat(b[i]));
    for (let c=0; c<n; c++) {
      let p = c; for (let r=c+1; r<n; r++) if (Math.abs(M[r][c]) > Math.abs(M[p][c])) p = r;
      [M[c],M[p]] = [M[p],M[c]];
      const d = M[c][c]; for (let j=c; j<=n; j++) M[c][j] /= d;
      for (let r=0; r<n; r++) { if (r===c) continue; const f = M[r][c]; for (let j=c; j<=n; j++) M[r][j] -= f*M[c][j]; }
    }
    return M.map(r => r[n]);
  }
  function warpScreen() {
    // Overscan: push the target corners slightly outward so the screen bleeds past
    // the mask edges (which then trim it cleanly) - no gap along the rounded border.
    const OVER = 0.035;
    const cx = (QUAD[0].x+QUAD[1].x+QUAD[2].x+QUAD[3].x)/4, cy = (QUAD[0].y+QUAD[1].y+QUAD[2].y+QUAD[3].y)/4;
    const dst = QUAD.map(p => ({ x: cx + (p.x-cx)*(1+OVER), y: cy + (p.y-cy)*(1+OVER) }));
    const src = [{x:0,y:0},{x:SCREEN_W,y:0},{x:SCREEN_W,y:SCREEN_H},{x:0,y:SCREEN_H}];
    const A = [], b = [];
    for (let i=0; i<4; i++) {
      A.push([src[i].x,src[i].y,1,0,0,0,-src[i].x*dst[i].x,-src[i].y*dst[i].x]); b.push(dst[i].x);
      A.push([0,0,0,src[i].x,src[i].y,1,-src[i].x*dst[i].y,-src[i].y*dst[i].y]); b.push(dst[i].y);
    }
    const h = solve8(A, b);
    const H = [h[0],h[3],0,h[6], h[1],h[4],0,h[7], 0,0,1,0, h[2],h[5],0,1];
    screen.style.transform = 'matrix3d(' + H.join(',') + ')';
  }
  function fitPhoto() {
    const ph = document.getElementById('nu-photo'), inner = document.getElementById('nu-photo-inner');
    if (ph && inner) inner.style.transform = 'scale(' + (ph.clientWidth / NW) + ')';
  }

  // ---- render mode: flat device SVGs ----
  // Two geometries cover all the artwork: every Brick / Brick Hammer colorway shares
  // one screen rect, every Smart Pro / Pro S shares another.
  // x/y/w/h is the dark glass panel in the artwork. The live screen is inset inside
  // it so that panel reads as a bezel band, and nudged up (dy) because sitting dead
  // center in the glass looks low against the hardware. The stage itself is a fixed
  // box in CSS, so nothing here sizes it.
  const FAM = {
    brick:    { vw:1280, vh:1280, x:334, y:194, w:602,  h:426, r:6, inset:16, dy:-5  },
    smartpro: { vw:2200, vh:960,  x:460, y:105, w:1280, h:760, r:0, inset:34, dy:-12 },
  };
  const DEVICES = [
    { id:'brick_black',         name:'Brick · Black',         fam:'brick' },
    { id:'brick_white',         name:'Brick · White',         fam:'brick' },
    { id:'brick_purple',        name:'Brick · Purple',        fam:'brick' },
    { id:'brick_red',           name:'Brick · Red',           fam:'brick' },
    { id:'brick_hammer_black',  name:'Brick Hammer · Black',  fam:'brick' },
    { id:'brick_hammer_gray',   name:'Brick Hammer · Gray',   fam:'brick' },
    { id:'brick_hammer_green',  name:'Brick Hammer · Green',  fam:'brick' },
    { id:'brick_hammer_pink',   name:'Brick Hammer · Pink',   fam:'brick' },
    { id:'brick_hammer_silver', name:'Brick Hammer · Silver', fam:'brick' },
    { id:'smart_pro_black',     name:'Smart Pro · Black',     fam:'smartpro' },
    { id:'smart_pro_white',     name:'Smart Pro · White',     fam:'smartpro' },
    { id:'smart_pro_retro',     name:'Smart Pro · Retro',     fam:'smartpro' },
    { id:'smart_pro_s_black',   name:'Smart Pro S · Black',   fam:'smartpro' },
    { id:'smart_pro_s_white',   name:'Smart Pro S · White',   fam:'smartpro' },
    { id:'smart_pro_s_green',   name:'Smart Pro S · Green',   fam:'smartpro' },
    { id:'smart_pro_s_red',     name:'Smart Pro S · Red',     fam:'smartpro' },
    { id:'smart_pro_s_yellow',  name:'Smart Pro S · Yellow',  fam:'smartpro' },
    { id:'smart_pro_s_retro',   name:'Smart Pro S · Retro',   fam:'smartpro' },
  ];
  const renderEl = document.getElementById('nu-render');
  const renderImg = document.getElementById('nu-render-img');
  const renderScreen = document.getElementById('nu-render-screen');
  const photoEl = document.getElementById('nu-photo');
  const deviceSel = document.getElementById('nu-device');
  const modePhotoBtn = document.getElementById('nu-mode-photo');
  const modeRenderBtn = document.getElementById('nu-mode-render');
  const screenClip = document.querySelector('.nu-screen-clip');

  // Which device you preview on is a viewing preference, not part of the theme, so it
  // stays out of the share link (and out of the OG worker's cache key) and lives here.
  let mode = 'photo', device = DEVICES[0].id;
  try {
    if (localStorage.getItem('nu-mode') === 'render') mode = 'render';
    const d = localStorage.getItem('nu-device');
    if (d && DEVICES.some(x => x.id === d)) device = d;
  } catch (_) {}

  DEVICES.forEach(d => {
    const o = document.createElement('option');
    o.value = d.id; o.textContent = d.name;
    deviceSel.appendChild(o);
  });
  deviceSel.value = device;

  // Size the screen to the device's own aspect rather than a fixed 4:3, so the UI
  // reflows the way it does on real hardware instead of being stretched, then place
  // it on the artwork's screen rect with a single uniform scale.
  function layoutRender() {
    const d = DEVICES.find(x => x.id === device) || DEVICES[0];
    const f = FAM[d.fam];
    const cssW = renderImg.clientWidth;       // measure the art itself
    if (!cssW) return;
    const k = cssW / f.vw;                    // artwork units -> css px
    // Inset the same amount on both axes so the bezel band reads as even width;
    // the UI reflows to whatever aspect that leaves rather than being stretched.
    const ix = f.inset, iy = f.inset;
    const x = f.x + ix, y = f.y + iy + f.dy;
    const w = f.w - ix * 2, h = f.h - iy * 2;
    renderScreen.style.left = (renderImg.offsetLeft + x * k) + 'px';
    renderScreen.style.top = (renderImg.offsetTop + y * k) + 'px';
    renderScreen.style.width = (w * k) + 'px';
    renderScreen.style.height = (h * k) + 'px';
    renderScreen.style.borderRadius = (Math.max(f.r - ix * 0.5, 0) * k) + 'px';
    const sw = Math.round(SCREEN_H * (w / h));
    screen.style.width = sw + 'px';
    screen.style.height = SCREEN_H + 'px';
    screen.style.transform = 'scale(' + ((w * k) / sw) + ')';
  }

  function setMode(next) {
    mode = next === 'render' ? 'render' : 'photo';
    const isR = mode === 'render';
    renderEl.hidden = !isR; photoEl.hidden = isR; deviceSel.hidden = !isR;
    modePhotoBtn.classList.toggle('on', !isR);
    modeRenderBtn.classList.toggle('on', isR);
    modePhotoBtn.setAttribute('aria-pressed', String(!isR));
    modeRenderBtn.setAttribute('aria-pressed', String(isR));
    if (isR) {
      const d = DEVICES.find(x => x.id === device) || DEVICES[0];
      renderImg.src = '/nextui/devices/' + d.id + '.svg';
      renderImg.alt = d.name + ' running NextUI';
      renderScreen.appendChild(screen);      // one screen element, re-parented per mode
      layoutRender();
    } else {
      screenClip.appendChild(screen);
      screen.style.width = SCREEN_W + 'px';
      screen.style.height = SCREEN_H + 'px';
      warpScreen();
      fitPhoto();
    }
    try { localStorage.setItem('nu-mode', mode); } catch (_) {}
  }

  modePhotoBtn.addEventListener('click', () => setMode('photo'));
  modeRenderBtn.addEventListener('click', () => setMode('render'));
  deviceSel.addEventListener('change', () => {
    device = deviceSel.value;
    try { localStorage.setItem('nu-device', device); } catch (_) {}
    if (mode === 'render') setMode('render');
  });
  // The SVG can finish decoding after layout; re-place the screen once it has.
  renderImg.addEventListener('load', () => { if (mode === 'render') layoutRender(); });

  // ---- init ----
  applyURL();
  buildList();
  buildElements();
  nameIn.value = name === 'Custom' ? '' : name;
  paintScreen();
  loadPicker();
  updateCode();
  warpScreen();
  fitPhoto();
  setMode(mode);   // applies the remembered preview mode
  window.addEventListener('resize', () => { fitPhoto(); if (mode === 'render') layoutRender(); });
</script>
