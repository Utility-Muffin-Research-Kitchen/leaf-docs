---
// Shown when there are no themes to list.
---

<div class="tg-empty">
  <svg class="tg-empty__art" viewBox="0 0 160 120" aria-hidden="true">
    <rect x="4" y="4" width="152" height="112" rx="12" fill="none" stroke="currentColor" stroke-width="3" />
    {[0, 1, 2].map((c) =>
      [0, 1].map((r) => (
        <rect x={20 + c * 42} y={24 + r * 40} width="34" height="32" rx="6" fill="none"
          stroke="currentColor" stroke-width="2.5" stroke-dasharray="5 4" />
      ))
    )}
  </svg>
  <h2 class="tg-empty__title">No themes yet</h2>
  <p class="tg-muted">
    Themes people share show up here once they are reviewed and published to Pak Rat.
  </p>
  <p><a class="tg-btn tg-empty__cta" href="/guide/submit-a-theme/">Submit a theme</a></p>
</div>

<style is:global>
  .tg-empty {
    display: grid;
    justify-items: center;
    gap: 0.6rem;
    padding: 2.5rem 1.25rem;
    border: 2px dashed var(--tg-border);
    border-radius: var(--tg-radius);
    text-align: center;
  }
  .tg-empty__art { width: 7rem; height: auto; color: var(--sl-color-accent); opacity: 0.8; }
  .tg-empty__title { font-size: var(--sl-text-2xl); }
  .tg .tg-empty__cta {
    margin-top: 0.4rem;
    background: var(--sl-color-accent);
    border-color: var(--sl-color-accent);
    color: var(--sl-color-black);
  }
</style>
